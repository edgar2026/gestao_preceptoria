# .gitignore — Sistema de Gestão de Preceptoria

# Ambiente e segredos
.env
.env.*
!.env.example
supabase/.env
supabase/env

# Documentos privados (regras financeiras, diagnósticos, dados sensíveis)
private/
docs/private/

# Planilhas e bases de importação
*.xlsx
*.xls
*.csv

# Build e cobertura
dist/
build/
coverage/

# Dependências
node_modules/

# Supabase local
supabase/.branches
supabase/.temp

# Logs e temporários
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vscode/settings.json
*.swp
*.swo
*.bak*
*.backup
*.dump
*.sql.gz

# Relatórios de prévia/diagnóstico/importação e áreas de trabalho temporárias
PREVIA_*.md
RESULTADO_*.md
PLANO_IMPORTACAO_*.md
MAPA_CONFLITOS_*.md
scratch/

# OS
.DS_Store
Thumbs.db
